{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larecipe.saleem.dev/schemas/3.x/navigation.json",
  "title": "LaRecipe navigation (navigation.json)",
  "description": "The navigation of one version: tabs of groups and pages. Without this file, navigation is derived from folders and frontmatter.",
  "oneOf": [
    {
      "type": "object",
      "required": ["tabs"],
      "properties": {
        "$schema": { "type": "string" },
        "tabs": { "type": "array", "items": { "$ref": "#/$defs/tab" } }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "anyOf": [{ "required": ["groups"] }, { "required": ["pages"] }],
      "properties": {
        "$schema": { "type": "string" },
        "groups": { "$ref": "#/$defs/items" },
        "pages": { "$ref": "#/$defs/items" }
      },
      "additionalProperties": false
    },
    { "$ref": "#/$defs/items" }
  ],
  "$defs": {
    "tab": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "href": { "type": "string" },
        "groups": { "$ref": "#/$defs/items" },
        "pages": { "$ref": "#/$defs/items" }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1, "description": "A page path, for example billing/webhooks." },
        {
          "type": "object",
          "description": "A group of pages.",
          "required": ["pages"],
          "properties": {
            "group": { "type": "string" },
            "label": { "type": "string" },
            "icon": { "type": "string" },
            "collapsed": { "type": "boolean" },
            "pages": { "$ref": "#/$defs/items" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A page with its own label or icon.",
          "required": ["page"],
          "properties": {
            "page": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "icon": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "An external link.",
          "required": ["href"],
          "properties": {
            "label": { "type": "string" },
            "href": { "type": "string", "minLength": 1 },
            "icon": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
