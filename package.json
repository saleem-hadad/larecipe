{
  "name": "larecipe-workspace",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @larecipe/app build",
    "dev": "pnpm --filter @larecipe/app dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:browser": "playwright test -c tests/Browser/playwright.config.ts",
    "test:ui": "pnpm --filter @larecipe/app test",
    "icons": "node packages/ui/scripts/generate-icons.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
