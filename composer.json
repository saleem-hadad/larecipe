{
    "name": "larecipe/larecipe",
    "description": "Living documentation for Laravel apps. Your coding agents write the docs and keep them current; every reader, human or agent, gets the current answer.",
    "keywords": [
        "laravel",
        "documentation",
        "docs",
        "markdown",
        "mcp",
        "llms.txt",
        "agents",
        "ai"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://larecipe.saleem.dev",
    "support": {
        "issues": "https://github.com/saleem-hadad/larecipe/issues",
        "source": "https://github.com/saleem-hadad/larecipe"
    },
    "authors": [
        {
            "name": "Saleem Hadad",
            "email": "saleem@binary-torch.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.62|^13.0",
        "illuminate/contracts": "^12.62|^13.0",
        "illuminate/database": "^12.62|^13.0",
        "illuminate/http": "^12.62|^13.0",
        "illuminate/routing": "^12.62|^13.0",
        "illuminate/support": "^12.62|^13.0",
        "illuminate/view": "^12.62|^13.0",
        "laravel/mcp": "^1.0",
        "laravel/prompts": "^0.3",
        "league/commonmark": "^2.10.3",
        "opis/json-schema": "^2.4",
        "phiki/phiki": "^2.2",
        "symfony/html-sanitizer": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/ai": "^1.2",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "laravel/ai": "Ask AI for readers and the larecipe:sync docs agent (^1.2)",
        "nikic/php-parser": "Symbol-level sources (App\\Billing\\Invoice::refund) for drift detection"
    },
    "autoload": {
        "psr-4": {
            "LaRecipe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaRecipe\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "bin": [
        "bin/larecipe-hook"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "LaRecipe\\LaRecipeServiceProvider"
            ],
            "aliases": {
                "LaRecipe": "LaRecipe\\Facades\\LaRecipe"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
